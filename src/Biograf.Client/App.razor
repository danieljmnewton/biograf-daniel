<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <div class="kort">
                            <h2>Ingen behörighet</h2>
                            <p class="dampad">Den här sidan är bara till för personal och administratörer.</p>
                        </div>
                    }
                    else
                    {
                        <RedirectTillInloggning />
                    }
                </NotAuthorized>
                <Authorizing>
                    <Laddar Text="Kontrollerar inloggning…" />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Sidan finns inte – Newtons Biograf</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="kort">
                    <h1>Sidan finns inte</h1>
                    <p class="dampad">Adressen leder ingenstans. <a href="">Tillbaka till startsidan</a>.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
