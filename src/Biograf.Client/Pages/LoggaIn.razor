@page "/logga-in"
@inject ApiKlient Api
@inject JwtAuthStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Logga in – Newtons Biograf</PageTitle>

<div class="auth-sida">
    <h1>Logga in</h1>

    <div class="kort">
        <Meddelande Text="@fel" />

        <EditForm Model="modell" OnValidSubmit="SkickaAsync" class="formular">
            <DataAnnotationsValidator />

            <div class="falt">
                <label for="email">E-post</label>
                <InputText id="email" type="email" @bind-Value="modell.Email" autocomplete="username" />
                <ValidationMessage For="() => modell.Email" />
            </div>

            <div class="falt">
                <label for="losenord">Lösenord</label>
                <InputText id="losenord" type="password" @bind-Value="modell.Losenord" autocomplete="current-password" />
                <ValidationMessage For="() => modell.Losenord" />
            </div>

            <button class="knapp knapp-primar" type="submit" disabled="@skickar">
                @(skickar ? "Loggar in…" : "Logga in")
            </button>
        </EditForm>

        <p class="dampad" style="margin-bottom:0">Inget konto? <a href="registrera">Bli medlem</a></p>
    </div>

    <div class="kort testkonton">
        <strong>Testkonton</strong> <span class="dampad">– klicka för att fylla i</span>
        <table>
            @foreach (var (roll, email, losen) in testkonton)
            {
                <tr>
                    <td>@roll</td>
                    <td><button type="button" @onclick="() => FyllI(email, losen)">@email</button></td>
                    <td class="dampad">@losen</td>
                </tr>
            }
        </table>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tillbaka")]
    public string? Tillbaka { get; set; }

    private readonly LoggaInDto modell = new();
    private string? fel;
    private bool skickar;

    // Seedade konton (se AnvandarSeeder i API:t), för att det ska gå snabbt att demonstrera rollerna.
    private readonly (string Roll, string Email, string Losen)[] testkonton =
    [
        ("Admin", "admin@biograf.se", "Admin123"),
        ("Personal", "personal@biograf.se", "Personal123"),
        ("Kund", "kund@biograf.se", "Kund123")
    ];

    private void FyllI(string email, string losen)
    {
        modell.Email = email;
        modell.Losenord = losen;
    }

    private async Task SkickaAsync()
    {
        skickar = true;
        fel = null;

        var svar = await Api.PostAsync<InloggningSvar>("api/auth/logga-in", modell);
        if (svar.Lyckades && svar.Data is not null)
        {
            await AuthState.LoggaInAsync(svar.Data);
            Navigation.NavigateTo(string.IsNullOrEmpty(Tillbaka) ? "" : Tillbaka);
        }
        else
        {
            fel = svar.Fel;
        }

        skickar = false;
    }
}
